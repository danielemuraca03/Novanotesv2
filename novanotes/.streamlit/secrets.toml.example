# ──────────────────────────────────────────────
# NovaNotes — Streamlit Secrets
# ──────────────────────────────────────────────
# INSTRUCTIONS:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Replace the placeholder values with your real credentials
# 3. NEVER commit this file to Git (it's in .gitignore)
#
# For Streamlit Cloud deployment:
#   Go to your app settings > Secrets and paste these values there.
# ──────────────────────────────────────────────

# Gmail SMTP for sending verification emails
# To get a Gmail App Password:
# 1. Go to myaccount.google.com > Security > 2-Step Verification
# 2. At the bottom, click "App passwords"
# 3. Generate one for "Mail" > "Other" > name it "NovaNotes"
SMTP_EMAIL = "your-email@gmail.com"
SMTP_PASSWORD = "your-16-char-app-password"

# The public URL of your deployed app
APP_URL = "https://your-app-name.streamlit.app"
